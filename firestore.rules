rules_version = '2';

// ============================================================
// Reglas de seguridad (Firestore → Reglas → pegar → Publicar)
// Cada negocio = una cuenta. El id del negocio es el uid del
// dueño, así nadie puede ver ni tocar los datos de otro negocio.
// El bot de WhatsApp (Netlify Functions) usa una cuenta de
// servicio de administrador, que no pasa por estas reglas.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Equipo de Reservo: da de alta negocios y puede entrar a
    // revisarlos y configurarlos. Debe coincidir con correoAdmin de
    // public/firebase-config.js y ADMIN_EMAILS de Netlify.
    function esAdmin() {
      return request.auth != null && request.auth.token.email == 'alejandrosant2001@gmail.com';
    }

    function esDueno(negocioId) {
      return request.auth != null && (request.auth.uid == negocioId || esAdmin());
    }

    // Membresía de cada negocio (la escribe el panel desde el servidor)
    match /cuentas/{negocioId} {
      allow read: if esDueno(negocioId);
      allow write: if false;
    }

    match /negocios/{negocioId} {
      allow read, write: if esDueno(negocioId);

      // Datos del negocio (servicios, clientes, citas, caja, etc.)
      match /{coleccion}/{docId} {
        allow read, write: if esDueno(negocioId)
          && coleccion in ['servicios', 'profesionales', 'clientes', 'citas', 'movimientos', 'cajas', 'avisos', 'dispositivos', 'conversaciones', 'privado'];
      }

      // Registro interno del bot para no responder dos veces
      match /mensajesProcesados/{id} {
        allow read, write: if false;
      }
    }

    // Qué número de WhatsApp Business pertenece a qué negocio
    match /whatsappNumeros/{phoneNumberId} {
      allow read: if esDueno(resource.data.negocioId);
      allow create: if esDueno(request.resource.data.negocioId);
      allow update: if esDueno(resource.data.negocioId) && esDueno(request.resource.data.negocioId);
      allow delete: if esDueno(resource.data.negocioId);
    }
  }
}
